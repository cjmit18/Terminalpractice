{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker connected to this repo in the Cloudflare dashboard (Workers Builds).
  // terminuscli serves https://terminuscli.com (custom domain set in the dashboard).
  "name": "terminuscli",
  // No preview links for the live site: pull-request builds still build and test, but test features are
  // previewed on the test site (https://<branch>.terminus.wayne-mitchell.com, branch site/wayne-mitchell).
  // Set explicitly so a deploy never turns them back on.
  "preview_urls": false,
  "compatibility_date": "2026-10-13",
  // `wrangler deploy` and `wrangler preview` run this first, so a deploy never ships a stale or
  // missing dist/, and Workers Builds (production and pull-request previews) only ships code that
  // passes the unit tests and all three typechecks. The build image installs devDependencies
  // (npm clean-install), which is where tsx, typescript and wrangler itself come from.
  "build": {
    // Absolute asset paths: with the SPA fallback, /any/path serves index.html, and its assets must still resolve from /
    "command": "npm test && npm run lint && VITE_BASE=/ npm run build"
  },
  // Account API (sign-in, sessions). Only /api/* reaches it; see run_worker_first below.
  "main": "./worker/index.ts",
  // Daily sweep of expired sessions, one-time tokens and rate-limit rows (worker/maintenance.ts)
  "triggers": { "crons": ["17 3 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The app routes with #/ hashes, so this only matters for typed or stale paths: they get the app, not a 404
    "not_found_handling": "single-page-application",
    // Everything except the API is served straight from the edge without running Worker code
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // The same accounts database as the terminus-wm Worker (site/wayne-mitchell), so one account works on both sites
      "database_name": "terminalpractice",
      "database_id": "741adee3-13fb-48e7-90c1-34024d069bfa",
      "migrations_dir": "migrations"
    }
  ],
  // Pull-request builds run `wrangler preview`, which needs its own preview-safe settings (nothing here
  // is inherited from above). Previews get sign-in turned off and an empty database of their own, so a
  // preview link can never touch real accounts. The preview database is deliberately left empty (no
  // migrations are applied to it): with sign-in off nothing ever writes to it, and /api/me answers
  // "signed out" when the account tables are missing, so a stray session cookie cannot cause an error.
  "previews": {
    // Preview databases hold no real accounts, so rate limits may use plain SHA-256 keys there
    "vars": { "GITHUB_CLIENT_ID": "", "ALLOW_UNPEPPERED_RATE_LIMITS": "1" },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "terminuscli-preview",
        "database_id": "03f84a31-ace4-4c07-b144-df736596fd4d",
        "migrations_dir": "migrations"
      }
    ]
  },
  "vars": {
    // Client ID of the GitHub App used for "Sign in with GitHub" (public, not a secret).
    // The client secret is set separately: npx wrangler secret put GITHUB_CLIENT_SECRET
    // While either is missing, the app hides "Sign in" and the API answers 503 for sign-in.
    "GITHUB_CLIENT_ID": "Iv23liq8G8SDh8dctkWx",
    // Account emails (verification links) go out through this Purelymail mailbox over SMTP (worker/smtp.ts).
    // Its password is a secret: npx wrangler secret put SMTP_PASSWORD. Without it no email is sent.
    // Previews (above) have none of these, so a preview build never sends email. See docs/EMAIL_SETUP.md.
    "SMTP_USER": "no-reply@terminuscli.com"
  }
}
